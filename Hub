-- Hàm tạo nút có animation (mỗi nút cao 37px + 6px hở = 80px)
local function MakeBtn(txt, y, col)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(0, 96, 0, 37)
    b.Position = UDim2.new(1, -106, 0, y)
    b.BackgroundColor3 = col
    b.Text = txt
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    b.MouseEnter:Connect(function() TS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.2}):Play() end)
    b.MouseLeave:Connect(function() TS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play() end)
    return b
end

local CopyBtn = MakeBtn("Copy", 10, Color3.fromRGB(45, 48, 60))
local ExecBtn = MakeBtn("Execute", 53, Color3.fromRGB(0, 185, 125))

-- Animation mở bảng
Main.BackgroundTransparency = 1
TS:Create(Main, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()

-- Thay link script của bạn vào dòng dưới:
local Url = "https://pastefy.app/NbbWCnEn/raw"

CopyBtn.MouseButton1Click:Connect(function()
    if setclipboard then setclipboard('loadstring(game:HttpGet("'..Url..'"))()') end
    CopyBtn.Text = "Copied!"
    task.wait(1)
    CopyBtn.Text = "Copy"
end)

ExecBtn.MouseButton1Click:Connect(function()
    -- Bước 1: Kiểm tra xác nhận ID game khi bấm Execute
    ExecBtn.Text = "Checking..."
    task.wait(0.4)
    
    if game.PlaceId ~= TargetPlaceId then
        ExecBtn.Text = "Wrong ID!"
        ExecBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        task.wait(0.4)
        Players.LocalPlayer:Kick("Not Support [🙅]")
        return
    end

    -- Bước 2: Đúng ID game thì mới tiến hành Load script
    ExecBtn.Text = "Loading..."
    local ok = pcall(function() task.spawn(loadstring(game:HttpGet(Url))) end)
    if ok then
        ExecBtn.Text = "Done!"
        task.wait(0.5)
        Gui:Destroy()
    else
        ExecBtn.Text = "Error!"
        task.wait(1)
        ExecBtn.Text = "Execute"
    end
end)
