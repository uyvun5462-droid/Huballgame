-- Hàm thêm thẻ Script vào Tab Script (Hỗ trợ 1 hoặc nhiều PlaceId)
local function AddScriptCard(titleText, placeIds, scriptUrl)
	local idList = type(placeIds) == "table" and placeIds or {placeIds}
	local mainId = idList[1]

	local Card = Instance.new("Frame", ScriptPage)
	Card.Size = UDim2.new(1, 0, 0, 116)
	Card.BackgroundColor3 = Color3.fromRGB(23, 25, 33)
	Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

	local CardStroke = Instance.new("UIStroke", Card)
	CardStroke.Thickness = 1
	CardStroke.Color = Color3.fromRGB(40, 44, 58)

	-- Ảnh game bên trái (Lấy theo ID đầu tiên)
	local Icon = Instance.new("ImageLabel", Card)
	Icon.Size = UDim2.new(0, 96, 0, 96)
	Icon.Position = UDim2.new(0, 10, 0, 10)
	Icon.Image = "rbxthumb://type=Asset&id=" .. tostring(mainId) .. "&w=150&h=150"
	Icon.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
	Instance.new("UICorner", Icon).CornerRadius = UDim.new(0, 8)

	-- Tên Script ở giữa (phía trên)
	local Title = Instance.new("TextLabel", Card)
	Title.Size = UDim2.new(1, -220, 0, 50)
	Title.Position = UDim2.new(0, 116, 0, 12)
	Title.BackgroundTransparency = 1
	Title.Text = titleText
	Title.TextColor3 = Color3.new(1, 1, 1)
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 14
	Title.TextWrapped = true
	Title.TextXAlignment = Enum.TextXAlignment.Left
	Title.TextYAlignment = Enum.TextYAlignment.Top

	-- Text hiển thị danh sách ID Game ở giữa (phía dưới tên)
	local strIds = {}
	for _, v in ipairs(idList) do
		table.insert(strIds, tostring(v))
	end

	local IdLabel = Instance.new("TextLabel", Card)
	IdLabel.Size = UDim2.new(1, -220, 0, 36)
	IdLabel.Position = UDim2.new(0, 116, 0, 66)
	IdLabel.BackgroundTransparency = 1
	IdLabel.Text = "ID: " .. table.concat(strIds, "\n")
	IdLabel.TextColor3 = Color3.fromRGB(0, 220, 150)
	IdLabel.Font = Enum.Font.GothamSemibold
	IdLabel.TextSize = 11
	IdLabel.TextWrapped = true
	IdLabel.TextXAlignment = Enum.TextXAlignment.Left
	IdLabel.TextYAlignment = Enum.TextYAlignment.Top

	-- Hàm tạo 3 nút bên phải (Copy -> Join -> Execute)
	local function MakeBtn(txt, yPos, col)
		local b = Instance.new("TextButton", Card)
		b.Size = UDim2.new(0, 88, 0, 29)
		b.Position = UDim2.new(1, -98, 0, yPos)
		b.BackgroundColor3 = col
		b.Text = txt
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 13
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

		b.MouseEnter:Connect(function()
			TS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.2}):Play()
		end)
		b.MouseLeave:Connect(function()
			TS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
		end)
		return b
	end
	local CopyBtn = MakeBtn("Copy", 10, Color3.fromRGB(45, 48, 60))
	local JoinBtn = MakeBtn("Join", 43.5, Color3.fromRGB(0, 135, 220))
	local ExecBtn = MakeBtn("Execute", 77, Color3.fromRGB(0, 185, 125))

	-- Chức năng Copy
	CopyBtn.MouseButton1Click:Connect(function()
		if setclipboard then
			setclipboard('loadstring(game:HttpGet("' .. scriptUrl .. '"))()')
		end
		CopyBtn.Text = "Copied!"
		task.wait(1)
		CopyBtn.Text = "Copy"
	end)

	-- Chức năng Join game (Vào ID chính đầu tiên)
	JoinBtn.MouseButton1Click:Connect(function()
		local targetId = tonumber(mainId)
		if not targetId then
			JoinBtn.Text = "Invalid ID"
			task.wait(1)
			JoinBtn.Text = "Join"
			return
		end
		for _, id in ipairs(idList) do
			if game.PlaceId == tonumber(id) then
				JoinBtn.Text = "In Game!"
				task.wait(1)
				JoinBtn.Text = "Join"
				return
			end
		end

		JoinBtn.Text = "Joining..."
		local lp = Players.LocalPlayer
		local ok1 = pcall(function()
			local options = Instance.new("TeleportOptions")
			TeleportService:TeleportAsync(targetId, {lp}, options)
		end)
		if not ok1 then
			local ok2 = pcall(function()
				TeleportService:Teleport(targetId, lp)
			end)
			if not ok2 then
				JoinBtn.Text = "Error!"
				task.wait(1.2)
				JoinBtn.Text = "Join"
				return
			end
		end

		task.wait(3)
		if JoinBtn and JoinBtn.Parent then
			JoinBtn.Text = "Join"
		end
	end)

	-- Chức năng Execute (Kiểm tra trùng khớp 1 trong các ID là chạy)
	ExecBtn.MouseButton1Click:Connect(function()
		ExecBtn.Text = "Checking..."
		task.wait(0.3)

		local isSupported = false
		for _, id in ipairs(idList) do
			if game.PlaceId == tonumber(id) then
				isSupported = true
				break
			end
		end

		if not isSupported then
			ExecBtn.Text = "Wrong ID!"
			ExecBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			task.wait(0.4)
			Players.LocalPlayer:Kick("Not Support [🙅]")
			return
		end

		ExecBtn.Text = "Loading..."
		local ok, err = pcall(function()
			local code = nil
			local s1, r1 = pcall(function() return game:HttpGet(scriptUrl) end)
			if s1 and type(r1) == "string" and #r1 > 0 then
				code = r1
			else
				local req = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
				if req then
					local res = req({Url = scriptUrl, Method = "GET"})
					if res and res.Body then
						code = res.Body
					end
				end
			end

			assert(code and #code > 0, "Khong tai duoc noi dung tu link")
			local func, loadErr = loadstring(code)
			assert(type(func) == "function", loadErr or "Loi cu phap script")
			task.spawn(func)
		end)

		if ok then
			ExecBtn.Text = "Done!"
			task.wait(0.5)
			Gui:Destroy()
		else
			warn("[PRG Execute Error]:", err)
			ExecBtn.Text = "Error!"
			task.wait(1.2)
			ExecBtn.Text = "Execute"
		end
	end)
end

