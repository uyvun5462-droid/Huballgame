-- Hiệu ứng chuyển Tab mượt mà
local function SwitchTab(tabIndex)
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	if tabIndex == 1 then
		TS:Create(TabIndicator, tweenInfo, {Position = UDim2.new(0, 3, 0, 3)}):Play()
		TS:Create(ScriptPage, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
		TS:Create(LogPage, tweenInfo, {Position = UDim2.new(1, 0, 0, 0)}):Play()
		ScriptTabBtn.TextColor3 = Color3.new(1, 1, 1)
		LogTabBtn.TextColor3 = Color3.fromRGB(160, 165, 180)
	else
		TS:Create(TabIndicator, tweenInfo, {Position = UDim2.new(0.5, 3, 0, 3)}):Play()
		TS:Create(ScriptPage, tweenInfo, {Position = UDim2.new(-1, 0, 0, 0)}):Play()
		TS:Create(LogPage, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
		ScriptTabBtn.TextColor3 = Color3.fromRGB(160, 165, 180)
		LogTabBtn.TextColor3 = Color3.new(1, 1, 1)
	end
end

